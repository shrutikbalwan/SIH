// secrets.h.example — template for ira-wakeword/esp32/main/secrets.h
//
// Copy this file to secrets.h and fill in real values:
//
//     cp secrets.h.example secrets.h
//
// secrets.h is listed in .gitignore and must NEVER be committed.
// This .example file holds placeholders only — keep it that way.
//
// NOTE: as of this commit the firmware is an offline boot self-test with no
// networking (no esp_wifi, no sockets, no NVS). Nothing includes this header
// yet. It exists so that credentials land here — and only here — the moment a
// Wi-Fi or backend stage is added.

#pragma once

// --- Wi-Fi station credentials ---------------------------------------------
#define IRA_WIFI_SSID      "YOUR_WIFI_SSID"
#define IRA_WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

// --- Backend endpoint -------------------------------------------------------
// Host or URL the device reports to. Leave as-is until a backend exists.
#define IRA_BACKEND_HOST   "backend.example.com"
#define IRA_BACKEND_PORT   8883

// --- API credentials --------------------------------------------------------
// Token/key issued to this device by the backend.
#define IRA_API_TOKEN      "YOUR_API_TOKEN"

// --- OTA / provisioning (optional) ------------------------------------------
#define IRA_OTA_URL        "https://ota.example.com/ira/firmware.bin"
